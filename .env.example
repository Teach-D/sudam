# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sudam
POSTGRES_USER=sudam
POSTGRES_PASSWORD=sudam_dev

# ── Game Server ─────────────────────────────────────────────────────────────
GAME_SERVER_PORT=8080

# ── AI Service ──────────────────────────────────────────────────────────────
AI_SERVICE_PORT=8000

# ── Web ─────────────────────────────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:8080
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# ── LLM ─────────────────────────────────────────────────────────────────────
# Google Gemini API (aistudio.google.com/apikey 에서 발급 — 무료 티어 넉넉함)
GEMINI_API_KEY=AIza...
# 모델 선택 (기본: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Ollama (local wiring test — optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── KataGo ──────────────────────────────────────────────────────────────────
KATAGO_BINARY=./models/katago
KATAGO_MODEL=./models/kata1-b28c512nbt-s9584861952-d4960414494.bin.gz
KATAGO_HUMAN_MODEL=./models/b18c384nbt-humanv0.bin.gz
KATAGO_CONFIG=./models/katago_gtp.cfg

# ── Feature Flags ────────────────────────────────────────────────────────────
# Use recorded KataGo responses in CI (set to true in CI)
KATAGO_MOCK=false
